# Copy this file to .env in the same folder, then fill in your key.
# .env is git-ignored, so the key never gets committed. This example file has no secrets.
#
# Precedence: variables already set in your terminal win over this file.
# Set INCIDENT_PLATFORM_LOAD_DOTENV=false in the terminal to ignore the file entirely.

# ON/OFF switch for real LLM calls: true = OpenAI (needs the key and the openai package), false = mock
INCIDENT_PLATFORM_USE_REAL_LLM=false

# Your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Optional fallback provider: Anthropic Claude. If set (and `pip install anthropic`), calls that fail on
# OpenAI are retried on Claude before falling back to the mock. Leave empty to disable.
ANTHROPIC_API_KEY=
# INCIDENT_PLATFORM_ANTHROPIC_ACCURACY_MODEL=claude-opus-5
# INCIDENT_PLATFORM_ANTHROPIC_COST_MODEL=claude-haiku-4-5

# Optional: models to use if the defaults (gpt-4o / gpt-4o-mini) aren't available on your account
# INCIDENT_PLATFORM_ACCURACY_MODEL=gpt-4o
# INCIDENT_PLATFORM_COST_MODEL=gpt-4o-mini

# Optional: PII name detection: off | heuristic | spacy
# INCIDENT_PLATFORM_PII_NER=heuristic
